# ==========================================================================
# VortexAI Video Content Creator — Environment Configuration
# ==========================================================================

# OpenAI API Key (Optional)
# If provided in Vercel Environment Variables or local .env, advanced GPT-4o planning is used.
# If omitted or empty, the application runs seamlessly in deterministic local fallback mode.
OPENAI_API_KEY=

# OpenAI Model Selection (Optional)
# Default: gpt-4o-mini (supports gpt-4o, gpt-4o-mini, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Database Connection (Optional for Production / Vercel)
# In local development: Defaults to embedded zero-config SQLite.
# In production / Vercel: Set to your hosted PostgreSQL connection URI (e.g., Neon, Supabase, Vercel Postgres).
# Example: postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Server Configuration
PORT=5000
FLASK_ENV=production
